БББББВВББББББВББВВВБББВББББББББББББББББВВБВББВБВВББББББВВБВБББВББВВБВББББББББВББББВБББББВБББББВББВБВБВБВВВВВБББББВББББББББВБВБББББББВВББББВББВББББВВБББББББББББББББВББББББВБББББВББББББББББББББВБББББВББББВВБББВВББББББВВББББББББББВББББВББББВВББВББББББВББББББББББББВББВББББББББВББББББББВВВББВББББББББББВВБББВБВБВВВБББББВБВБББББББББББББВББББВВБВБББББББВВББББВВБВБВББББББББВББВББББББВБВВББББВВББББББББББВВББВББВВБББББВББВББББВБББББББББББББВБВВБВБВБББББББББББББББВВББББВВББВВБББВБББББББББББББББББББББВВБВБББВББВБВББББВВБВВБВББББББББББББВББВББББВББББВБВБВББББВББВБВББББББВБВБВВБББВБББВББББВВБББВВББББВББББВББББББВВВБВВББББВББББББВББББББВБВВБББББВББББББББББВББББББББВБББВББВБВВБВБББББВБББВВББВБББВББББВБББББВББББББВБББББВВББВББББББББВББББВВВББББББВББББББВББББББББВББББББВББББВБББВБВБВБВБББББВБББББББББВБББББББВБВБВБББВББББВБББВБББББВББББББВБББББВБББВБББББВБВВВББББВВВБББВБВВББВВВББВБББВВББББВВБББББББВБББББВБББВБББББВБББВБВВБББВВББББВВБББББВБББББББББВБББВБББББВБВБББВББВББББВБББББВББВББББББВБББББВБББББВБББББББББВВББББББВБББББВББВВББББББВБББББББВБББВВББВББББББВББББББББВББВБББББВБВВВББББББББББВВБВБВББББББВББВББВБВБББББВВББББББВВВББВБББББВБББВВББВББВВБББББББББББББВББББББББВБББББВБВББББББВББВВББВБВБВВББВБББВБВБББВБББВБВББББББВББВБВББВББВБВБББББББББВББВББББББББВБББББВБББВВВББББББББВББВБВВБББББББББББВБББВБВВББВВВБВБВВББББББББВББВВББББВБВБВББББВВБББВБВБВББББВВББВББВВБББББВБББББВБББВБББББББВВББББББББВБББББББВВБВВББББББББББВВББББВБВВБВБББВВБББВВБВБББВБББББББББВБВББББББВБББББВББББВБВББББББББББББББББББББББББББББББВБВБББВБББББВБББББВББББББББББББББББББББББББББББББББББББВББББББВБББББВБББББВББББББВББВБББББББББББББББВББВББББББББББББВББВБББББВВБББББББББВБББББББББББББББББББББББВВВБББББББББББВББВББББББББВБББББББББББББББББВББББББББББВББВББББББВБВБББВВБББББББББВВББББББББББББББББББВВББВВБББББВБВБББББББББББББББВВББББББББББББББББББББВБББББББВБББББВБББББББББББББВББББББВББББББББББББВБББББББВБВБВБББББВВВБББВББВББББББББББББББВБББББББББВВБББББББББББВББББВББББББББББВВВБББББВБВВББВВВББВБББББББББВБББББВББББББВБББББББББББББВББВББББВБВББББББВББББББББВБББББББББВБББВВБВБББВБББББВББББББББББББББВВББББББББВВВББББББББВБББББББВВБББББББВББВББББВББББВВБББББББББВБББББББББВББББВББББББББББББББББББББББББВБВБББББББББВВББВБВБББББББВББББББББББББББББББВБББББВБББББББББББББББББББББББББВБВББББББББББВББББВВББББВБВБББББББББВБББББББББББББВВББВББВБББББББББББВББББВБББББББВВБВВББББББВБВБББББББВББВБВБВВБВББББББВВБББББВБББВВВВББВББББББВБББББББВВБВБВБВББББВБВББВББББВББББББВБВБББББВББВББББББВБВВВББВББВВБББВБВБББББББББВБББББББББББВВБВБББББББББББББББВБББББВБВББВБББВБББВББББББББББББББББББББББББВВББББВББББВББВВБББВБББББББББББВБББББВБББББББББББББББББББВББВБББББББВВББВБББББББББББВБББББВБББББББББББББВББББВВББББВВБББВБББББВББББББББВБББББВВБББВББВБВБББББББВБББББББВБВВБВБББББББВВБББББББББВБББББББББББББББББББВВББВВБББББББББВБББББББББВБББББББВБББББББВВВББББВБББББББВВББББББББББББББББББББВББББББВБВБВББББББББББББББББВБВВБББББББББББББББВВБББББББББВББББББББББББББВББВББББББББББББББВБББББББББББББББББВБББББББББВББВБББББББББВББББББББВБВББВБВББВВБББББВББВБББВБББВББББББВВБББББВВББВВВБББББВВБББББББВББББББВБББББВББВББББББВВВББВББББББББВБББББББББББВБВВББВБВБББББВВБББББББВББББББББВВБББББВБВБББВВБВББВВБВБВББББББББББББВБББББББББББББББББББББББББББВВББББВББББББВБББББВББББВБВББВВББББВББББББВБББВВБВБББВБВБББББББВББББВБББВБВВБББВБББВББББВВВБВББВББББББВБББББВВББВБВБББВВБВБВБВББББВВББББББББВБВВБББВББББВБББББББВББББББББББВБББББВВВБББББВБББББББВБВБББВБББББББВБББББББББВББББВББББББББВББВББББББББББББВББББББВББББББББББББББББББББББББББББББББББББББББВББББВБББББББББББББББББВБББББББББББББББВБББББББББВБББВБББББББББВБВБББББББББББВБББББВББББББВБББББББББВББВББББББББББББББББВБББББББББББББББББББББББББББББББББВБББББББББББББББВББББББББВБББББВББВВББББББВБББББББББВББББВББББВБББББББББББВББББВБББББББББББББББББББВБВБББББББББББББББББББББББББББББББВББББББББББВВБВБББББББВБВББББББББВБВБВББББББББББББББББББВББББББВББББББББББББВББББВББВБВБВББББББВБББББББВББББББББВББББББББВВВББББВБВББББВБББББББВБББВББББББББББББВБББББББВББББББВБББББББББББББВББВБВББВБББВБББББББББББББББББВБББББББББ